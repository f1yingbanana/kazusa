{
  "id": "kazusa",
  "channels": ["kazusa"],
  "kind": "context-engine",
  "name": "Kazusa",
  "description": "Multi-agent world simulation for roleplay.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "perception": {
        "type": "object",
        "properties": {
          "coalesceWindowMs": {
            "default": 500,
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "maxBatchSize": {
            "default": 16,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "maxBatchChars": {
            "default": 48000,
            "type": "integer",
            "minimum": 32000,
            "maximum": 256000
          },
          "decisionTimeoutMs": {
            "default": 10000,
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          }
        }
      },
      "contextEngine": {
        "type": "object",
        "properties": {
          "brainMaxTokens": {
            "default": 2000,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "shortTermHours": {
            "default": 24,
            "type": "number",
            "minimum": 24
          },
          "decisionMaxTokens": {
            "default": 8000,
            "type": "integer",
            "minimum": 2000,
            "maximum": 32000
          },
          "decisionShortTermHours": {
            "default": 4,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "decisionIdentityMaxTokens": {
            "default": 600,
            "type": "integer",
            "minimum": 0,
            "maximum": 32000
          },
          "decisionSoulMaxTokens": {
            "default": 1000,
            "type": "integer",
            "minimum": 0,
            "maximum": 32000
          },
          "decisionMemoryMaxTokens": {
            "default": 1000,
            "type": "integer",
            "minimum": 0,
            "maximum": 32000
          },
          "decisionBrainMaxTokens": {
            "default": 800,
            "type": "integer",
            "minimum": 0,
            "maximum": 32000
          },
          "decisionHistoryMaxTokens": {
            "default": 1600,
            "type": "integer",
            "minimum": 0,
            "maximum": 32000
          },
          "decisionWikiMaxTokens": {
            "default": 800,
            "type": "integer",
            "minimum": 0,
            "maximum": 32000
          },
          "decisionStimulusMaxTokens": {
            "default": 512,
            "type": "integer",
            "minimum": 32,
            "maximum": 8000
          },
          "decisionHistoryItems": {
            "default": 60,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "decisionWikiMaxArticles": {
            "default": 4,
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          }
        },
        "additionalProperties": false
      },
      "taskman": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "minDuration": {
            "type": "number",
            "minimum": 1,
            "description": "Minimum task duration in simulated minutes (default: 10)."
          }
        }
      },
      "user": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "default": "user:sensei",
            "pattern": "^user:[a-z0-9][a-z0-9_-]*$",
            "description": "Default human player identity for single-user MVP."
          },
          "name": {
            "type": "string",
            "default": "Sensei",
            "description": "Display name of the human player."
          }
        }
      }
    }
  },
  "contracts": {
    "tools": [
      "clock_now",
      "clock_set_speed",
      "clock_advance",
      "start_task",
      "delay_task",
      "send_message",
      "set_typing",
      "list_chats",
      "manage_chat"
    ]
  }
}
