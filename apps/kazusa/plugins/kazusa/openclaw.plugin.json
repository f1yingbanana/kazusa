{
  "id": "kazusa",
  "channels": ["kazusa"],
  "channelConfigs": {
    "kazusa": {
      "label": "Kazusa Brain",
      "description": "In-process admission of perceived stimuli to character brains.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      }
    }
  },
  "kind": "context-engine",
  "name": "Kazusa",
  "description": "Multi-agent world simulation for roleplay.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "perception": {
        "type": "object",
        "properties": {
          "coalesceWindowMs": {
            "default": 500,
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "maxBatchSize": {
            "default": 16,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "maxBatchChars": {
            "default": 48000,
            "type": "integer",
            "minimum": 32000,
            "maximum": 256000
          },
          "decisionTimeoutMs": {
            "default": 10000,
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          }
        }
      },
      "contextEngine": {
        "type": "object",
        "properties": {
          "brainMaxTokens": {
            "default": 2000,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "personalWikiMaxTokens": {
            "default": 1200,
            "type": "integer",
            "minimum": 0,
            "maximum": 32000
          },
          "personalWikiMaxArticles": {
            "default": 3,
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "shortTermHours": {
            "default": 24,
            "type": "number",
            "minimum": 24
          },
          "decisionMaxTokens": {
            "default": 8000,
            "type": "integer",
            "minimum": 2000,
            "maximum": 32000
          },
          "decisionShortTermHours": {
            "default": 4,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "decisionIdentityMaxTokens": {
            "default": 600,
            "type": "integer",
            "minimum": 0,
            "maximum": 32000
          },
          "decisionSoulMaxTokens": {
            "default": 1000,
            "type": "integer",
            "minimum": 0,
            "maximum": 32000
          },
          "decisionMemoryMaxTokens": {
            "default": 1000,
            "type": "integer",
            "minimum": 0,
            "maximum": 32000
          },
          "decisionBrainMaxTokens": {
            "default": 800,
            "type": "integer",
            "minimum": 0,
            "maximum": 32000
          },
          "decisionHistoryMaxTokens": {
            "default": 1600,
            "type": "integer",
            "minimum": 0,
            "maximum": 32000
          },
          "decisionWikiMaxTokens": {
            "default": 800,
            "type": "integer",
            "minimum": 0,
            "maximum": 32000
          },
          "decisionStimulusMaxTokens": {
            "default": 512,
            "type": "integer",
            "minimum": 32,
            "maximum": 8000
          },
          "decisionHistoryItems": {
            "default": 60,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "decisionWikiMaxArticles": {
            "default": 4,
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "skills": {
            "type": "object",
            "properties": {
              "conventions": {
                "type": "string",
                "default": "context-conventions"
              },
              "lifecycle": { "type": "string", "default": "task-lifecycle" },
              "interrupt": { "type": "string", "default": "task-interrupt" }
            }
          }
        },
        "additionalProperties": false
      },
      "taskman": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "minDuration": {
            "type": "number",
            "minimum": 1,
            "description": "Minimum task duration in simulated minutes (default: 10)."
          },
          "categories": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Allowed task categories presented to the LLM in start_task tool schema."
          },
          "supervisor": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean", "default": true },
              "intervalMs": { "type": "number", "default": 60000 },
              "maxAgentsPerTick": { "type": "integer", "default": 2 },
              "idleText": {
                "type": "string",
                "default": "Activity check-in: no scheduled activity."
              }
            }
          }
        }
      },
      "desires": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "states": {
            "type": "array",
            "minItems": 2,
            "description": "Ascending level-to-state mapping shown to the LLM. A level is in the last state whose min it reaches; level is where a task targeting the state settles.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "min", "level"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "min": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "level": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          },
          "initial": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "State an unseen desire starts in (default: fine)."
          },
          "catalog": {
            "type": "array",
            "minItems": 1,
            "description": "The world's desires. description is the semantic contract given to the LLM.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "description", "drain"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "drain": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Points lost per simulated hour on a 0-100 scale."
                }
              }
            }
          }
        }
      },
      "user": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "default": "user:sensei",
            "pattern": "^user:[a-z0-9][a-z0-9_-]*$",
            "description": "Default human player identity for single-user MVP."
          },
          "name": {
            "type": "string",
            "default": "Sensei",
            "description": "Display name of the human player."
          }
        }
      }
    }
  },
  "contracts": {
    "tools": [
      "clock_now",
      "clock_set_speed",
      "clock_advance",
      "start_task",
      "delay_task",
      "send_message",
      "list_chats",
      "manage_chat"
    ]
  }
}
