{
  "name": "@openrp-ai/kazusa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "openclaw": "cd world && OPENCLAW_CONFIG_PATH=./openclaw.json OPENCLAW_STATE_DIR=./.state openclaw",
    "gateway": "node ../../scripts/system-agent.mjs && node ../../scripts/plugin-startup.mjs && cd world && OPENCLAW_CONFIG_PATH=./openclaw.json OPENCLAW_STATE_DIR=./.state openclaw gateway",
    "status": "cd world && OPENCLAW_CONFIG_PATH=./openclaw.json OPENCLAW_STATE_DIR=./.state openclaw models status",
    "doctor": "cd world && OPENCLAW_CONFIG_PATH=./openclaw.json OPENCLAW_STATE_DIR=./.state openclaw doctor",
    "typecheck": "tsc -p plugins/kazusa",
    "test": "vitest run",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@openclaw/byteplus-provider": "2026.10.5",
    "@openclaw/cerebras-provider": "2026.10.5",
    "@openclaw/chutes-provider": "2026.10.5",
    "@openclaw/deepinfra-provider": "2026.10.5",
    "@openclaw/deepseek-provider": "2026.10.5",
    "@openclaw/fireworks-provider": "2026.10.5",
    "@openclaw/groq-provider": "2026.10.5",
    "@openclaw/mistral-provider": "2026.10.5",
    "@openclaw/moonshot-provider": "2026.10.5",
    "@openclaw/novita-provider": "2026.10.5",
    "@openclaw/parallel-plugin": "2026.10.5",
    "@openclaw/qwen-provider": "2026.10.5",
    "@openclaw/synthetic-provider": "2026.10.5",
    "@openclaw/venice-provider": "2026.10.5",
    "@openclaw/volcengine-provider": "2026.10.5",
    "@openclaw/zai-provider": "2026.10.5",
    "@openrp-ai/openclaw-provider": "0.1.0",
    "openclaw": "^2026.10.5"
  }
}
