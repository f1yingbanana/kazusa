  "plugins": {
    "allow": ["kazusa", "zai", "typesafe", "venice", "openrouter", "parallel"],
    "slots": {
      "contextEngine": "kazusa"
    },
    "load": {
      "paths": ["./plugins/kazusa"]
    },
    "entries": {
      "kazusa": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true
        },
        "config": {
          "contextEngine": {
            "brainMaxTokens": 2000,
            "shortTermHours": 24,
            "decisionMaxTokens": 8000,
            "decisionShortTermHours": 4,
            "decisionIdentityMaxTokens": 600,
            "decisionSoulMaxTokens": 1000,
            "decisionMemoryMaxTokens": 1000,
            "decisionBrainMaxTokens": 800,
            "decisionHistoryMaxTokens": 1600,
            "decisionWikiMaxTokens": 800,
            "decisionStimulusMaxTokens": 512,
            "decisionHistoryItems": 60,
            "decisionWikiMaxArticles": 4
          },
          "perception": {
            "coalesceWindowMs": 500,
            "maxBatchSize": 16,
            "maxBatchChars": 48000,
            "decisionTimeoutMs": 10000
          },
          "user": {
            "id": "user:sensei",
            "name": "Sensei"
          }
        }
      },
      "anthropic": {
        "config": {
          "sessionCatalog": {
            "enabled": false
          }
        }
      },
      "codex": {
        "config": {
          "sessionCatalog": {
            "enabled": false
          }
        }
      },
      "zai": {
        "enabled": true
      },
      "typesafe": {
        "enabled": true,
        "config": {
          "apiKey": {
            "source": "env",
            "provider": "default",
            "id": "TYPESAFE_API_KEY"
          }
        }
      },
      "venice": {
        "enabled": true
      },
      "openrouter": {
        "enabled": true
      },
      "parallel": {
        "enabled": true
      }
    }
  },
  "meta": {
    "migrations": {
      "modelPolicyAllowlist": true,
      "utilityModelSeparation": true
    },
    "lastTouchedVersion": "2026.10.5"
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "$include": "./openclaw.local.json",
      "mode": "token"
    },
    "port": 18789,
    "bind": "loopback",
    "trustedProxies": ["127.0.0.1", "::1"],
    "controlUi": {
      "allowedOrigins": ["*"]
    },
    "tailscale": {
      "mode": "off"
    }
  },
  "tools": {
    "deny": ["group:sessions", "message", "gateway"],
    "toolSearch": false,
    "codeMode": {
      "enabled": false
    },
    "sessions": {
      "visibility": "agent"
    },
    "profile": "minimal",
    "alsoAllow": [
      "start_task",
      "delay_task",
      "send_message",
      "list_chats",
      "manage_chat",
      "memory_search",
      "memory_get",
      "read",
      "edit",
      "write",
      "view_image"
    ],
    "fs": {
      "workspaceOnly": true
    },
    "exec": {
      "applyPatch": {
        "enabled": false
      }
    },
    "web": {
      "search": {
        "enabled": true,
        "provider": "parallel-free"
      }
    }
  },
  "messages": {
    "queue": {
      "mode": "steer"
    }
  },
  "memory": {
    "search": {
      "provider": "openai-compatible",
      "model": "text-embedding-3-small",
      "remote": {
        "baseUrl": "${AZURE_OPENAI_URL}",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "AZURE_OPENAI_API_KEY"
        }
      },
      "experimental": {
        "sessionMemory": true
      },
      "sources": ["memory", "sessions"]
    }
  },
  "skills": {
    "load": {
      "extraDirs": ["./shared/skills", "../../.agents/skills"]
    },
    "install": {
      "nodeManager": "npm"
    },
    "workshop": {
      "autonomous": {
        "mode": "off"
      }
    }
  },
  "auth": {
    "profiles": {
      "zai:default": {
        "provider": "zai",
        "mode": "api_key"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "zai": {
        "baseUrl": "https://api.z.ai/api/paas/v4",
        "api": "openai-completions",
        "models": [
          {
            "id": "glm-4.7-flashx",
            "name": "GLM-4.7-flashx"
          }
        ]
      },
      "venice": {
        "apiKey": {
          "source": "store",
          "provider": "default",
          "id": "VENICE_API_KEY"
        }
      }
    }
  },
  "hooks": {
    "internal": {
      "entries": {
        "session-memory": {
          "enabled": true
        }
      }
    }
  },
