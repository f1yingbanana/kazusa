{
  "agents": {
    "ownership": "explicit",
    "entries": {
      "main": {}
    },
    "defaults": {
      "workspace": "./workspaces",
      "compaction": {
        "enabled": false
      },
      "models": {
        "zai/glm-5.2": {
          "alias": "GLM"
        }
      },
      "model": {
        "primary": "zai/glm-5.2"
      }
    }
  },
  "plugins": {
    "slots": {
      "contextEngine": "kazusa"
    },
    "load": {
      "paths": ["./plugins/kazusa"]
    },
    "entries": {
      "kazusa": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true
        }
      },
      "anthropic": {
        "config": {
          "sessionCatalog": {
            "enabled": false
          }
        }
      },
      "codex": {
        "config": {
          "sessionCatalog": {
            "enabled": false
          }
        }
      },
      "zai": {
        "enabled": true
      }
    }
  },
  "meta": {
    "migrations": {
      "modelPolicyAllowlist": true,
      "utilityModelSeparation": true
    },
    "lastTouchedVersion": "2026.10.5"
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "$include": "./openclaw.local.json",
      "mode": "token"
    },
    "port": 18789,
    "bind": "loopback",
    "tailscale": {
      "mode": "off"
    }
  },
  "tools": {
    "profile": "full",
    "sessions": {
      "visibility": "agent"
    }
  },
  "messages": {
    "queue": {
      "mode": "steer"
    }
  },
  "memory": {
    "search": {
      "provider": "openai",
      "experimental": {
        "sessionMemory": true
      },
      "sources": ["memory", "sessions"]
    }
  },
  "skills": {
    "load": {
      "extraDirs": ["./shared/skills"]
    },
    "install": {
      "nodeManager": "npm"
    }
  },
  "auth": {
    "profiles": {
      "zai:default": {
        "provider": "zai",
        "mode": "api_key"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "zai": {
        "baseUrl": "https://api.z.ai/api/paas/v4",
        "api": "openai-completions",
        "models": []
      }
    }
  },
  "hooks": {
    "internal": {
      "entries": {
        "session-memory": {
          "enabled": true
        }
      }
    }
  },
  "wizard": {
    "lastRunAt": "2026-10-21T07:59:47.007Z",
    "lastRunVersion": "2026.10.5",
    "lastRunCommand": "onboard",
    "lastRunMode": "local"
  }
}
