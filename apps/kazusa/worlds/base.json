{
  "systemAgent": {
    "tools": {
      "profile": "full",
      "allow": [
        "kazusa",
        "ls",
        "read",
        "edit",
        "write",
        "apply_patch",
        "view_image",
        "web_fetch",
        "web_search"
      ],
      "deny": ["exec", "process", "code_execution", "openclaw"],
      "exec": {
        "security": "deny",
        "applyPatch": {
          "enabled": true,
          "workspaceOnly": false
        }
      },
      "fs": {
        "workspaceOnly": false
      },
      "elevated": {
        "enabled": false
      }
    },
    "skills": [
      "world-building",
      "world-project",
      "world-update",
      "kazusa",
      "openclaw",
      "typescript"
    ]
  },
  "config": {
    "agents": {
      "defaults": {
        "timeoutSeconds": 180,
        "workspace": "./workspaces",
        "userTimezone": "UTC",
        "compaction": {
          "enabled": false
        },
        "models": {
          "openrouter/z-ai/glm-5.3-flash": {},
          "openrouter/z-ai/glm-5.3": {}
        },
        "model": {
          "primary": "openrouter/z-ai/glm-5.3-flash"
        },
        "decisionModel": "kazusa/jev",
        "heartbeat": {
          "every": "0m"
        },
        "skipBootstrap": true,
        "skills": [],
        "modelPolicy": {}
      },
      "ownership": "explicit",
      "entries": {}
    },
    "plugins": {
      "allow": [
        "kazusa",
        "parallel",
        "anthropic",
        "byteplus",
        "cerebras",
        "chutes",
        "deepinfra",
        "deepseek",
        "fireworks",
        "google",
        "groq",
        "huggingface",
        "mistral",
        "moonshot",
        "novita",
        "nvidia",
        "ollama",
        "openai",
        "opencode-go",
        "openrouter",
        "qwen",
        "synthetic",
        "together",
        "venice",
        "volcengine",
        "xai",
        "zai"
      ],
      "slots": {
        "contextEngine": "kazusa",
        "memory": "none"
      },
      "load": {
        "paths": [
          "../plugins/kazusa",
          "../../../node_modules/@openclaw/parallel-plugin",
          "../../../node_modules/@openclaw/byteplus-provider",
          "../../../node_modules/@openclaw/cerebras-provider",
          "../../../node_modules/@openclaw/chutes-provider",
          "../../../node_modules/@openclaw/deepinfra-provider",
          "../../../node_modules/@openclaw/deepseek-provider",
          "../../../node_modules/@openclaw/fireworks-provider",
          "../../../node_modules/@openclaw/groq-provider",
          "../../../node_modules/@openclaw/mistral-provider",
          "../../../node_modules/@openclaw/moonshot-provider",
          "../../../node_modules/@openclaw/novita-provider",
          "../../../node_modules/@openclaw/qwen-provider",
          "../../../node_modules/@openclaw/synthetic-provider",
          "../../../node_modules/@openclaw/venice-provider",
          "../../../node_modules/@openclaw/volcengine-provider",
          "../../../node_modules/@openclaw/zai-provider"
        ]
      },
      "entries": {
        "kazusa": {
          "enabled": true,
          "hooks": {
            "allowConversationAccess": true
          },
          "subagent": {
            "allowModelOverride": true
          },
          "config": {
            "contextEngine": {
              "shortTermHours": 24,
              "decisionMaxTokens": 8000,
              "decisionShortTermHours": 4,
              "decisionIdentityMaxTokens": 600,
              "decisionSoulMaxTokens": 1000,
              "decisionMemoryMaxTokens": 1000,
              "decisionBrainMaxTokens": 800,
              "decisionHistoryMaxTokens": 1600,
              "decisionWikiMaxTokens": 800,
              "decisionStimulusMaxTokens": 512,
              "decisionHistoryItems": 60,
              "decisionWikiMaxArticles": 4
            },
            "memory": {
              "sleep": {
                "enabled": true
              },
              "embedding": {
                "baseUrl": "https://openrouter.ai/api/v1",
                "provider": "openrouter",
                "model": "openai/text-embedding-3-small"
              }
            },
            "perception": {
              "coalesceWindowMs": 10000,
              "maxBatchSize": 16,
              "maxBatchChars": 48000,
              "decisionTimeoutMs": 10000
            }
          }
        },
        "anthropic": {
          "config": {
            "sessionCatalog": {
              "enabled": false
            }
          },
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "codex": {
          "config": {
            "sessionCatalog": {
              "enabled": false
            }
          }
        },
        "parallel": {
          "enabled": true
        },
        "openrouter": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "venice": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "google": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "huggingface": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "nvidia": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "ollama": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "openai": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "opencode-go": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "together": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "xai": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "byteplus": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "cerebras": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "chutes": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "deepinfra": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "deepseek": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "fireworks": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "groq": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "mistral": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "moonshot": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "novita": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "qwen": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "synthetic": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "volcengine": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        },
        "zai": {
          "enabled": true,
          "hooks": {
            "allowPromptInjection": true
          }
        }
      }
    },
    "gateway": {
      "mode": "local",
      "auth": {
        "mode": "token"
      },
      "port": 18789,
      "bind": "loopback",
      "trustedProxies": ["127.0.0.1", "::1"],
      "tailscale": {
        "mode": "off"
      }
    },
    "tools": {
      "web": {
        "search": {
          "provider": "parallel-free"
        }
      },
      "deny": ["group:sessions", "message", "gateway"],
      "toolSearch": false,
      "codeMode": {
        "enabled": false
      },
      "sessions": {
        "visibility": "agent"
      },
      "profile": "minimal",
      "alsoAllow": [
        "start_task",
        "delay_task",
        "send_message",
        "list_chats",
        "manage_chat",
        "recall",
        "look_up",
        "remember",
        "view_image",
        "skills_read"
      ],
      "fs": {
        "workspaceOnly": true
      },
      "exec": {
        "applyPatch": {
          "enabled": false
        }
      }
    },
    "messages": {
      "queue": {
        "mode": "steer"
      }
    },
    "skills": {
      "load": {
        "extraDirs": ["./shared/skills", "../shared/skills"],
        "watch": false
      },
      "install": {
        "nodeManager": "npm"
      },
      "workshop": {
        "autonomous": {
          "mode": "off"
        }
      }
    },
    "hooks": {
      "internal": {
        "entries": {
          "session-memory": {
            "enabled": false
          }
        }
      }
    }
  }
}
