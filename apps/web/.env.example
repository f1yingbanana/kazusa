# Server-only connection. Match your local Gateway configuration.
KAZUSA_GATEWAY_URL=http://127.0.0.1:18789
# Supply the existing Gateway token in .env.local when Gateway token auth is on.
OPENCLAW_GATEWAY_TOKEN=

# Deployment auth mode: "local" (default zero-login desktop owner), "public" (read-only demo), or "trusted-proxy" (cloud wrapper)
KAZUSA_AUTH_MODE=local

# Required in trusted-proxy mode: Private shared secret for the upstream reverse proxy/wrapper
KAZUSA_TRUSTED_PROXY_SECRET=

# Optional in trusted-proxy mode: Public origin (e.g. https://world.openrp.ai) for CSRF same-origin checks
KAZUSA_PUBLIC_ORIGIN=

# Optional in trusted-proxy mode: World ID to verify against x-kazusa-world-id from the cloud wrapper
KAZUSA_WORLD_ID=
