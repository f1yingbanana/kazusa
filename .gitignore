# Dependencies
node_modules/
.pnp
.pnp.js

# Environment and Secrets
.env
.env.local
.env.*.local

# Runtime state and databases
.state/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.bak*

# Local OpenClaw config overrides
*.local.json
apps/kazusa/openclaw.local.json

# Local agent workspaces (untracked test data)
apps/kazusa/workspaces/*
!apps/kazusa/workspaces/.gitkeep
!apps/kazusa/workspaces/.template/

# Local simulation world data (untracked test locations & lore)
apps/kazusa/shared/locations/*
!apps/kazusa/shared/locations/.gitkeep
apps/kazusa/shared/lore/*
!apps/kazusa/shared/lore/.gitkeep

# Build outputs
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System
.DS_Store
*.pem
